+struct ODVNativeState {
+  std::mutex mutex;
+  odv::research::KnownBufferStates states;
+  odv::research::NativeBarrierEvents events;
+  uintptr_t list = 0, device = 0;
+  uint64_t legacy_calls = 0, enhanced_calls = 0, after_calls = 0;
+  uint64_t enhanced_buffers = 0, enhanced_textures = 0, enhanced_globals = 0;
+  bool protected_session = false;
+  std::atomic_bool failed = false;
+  ODVNativeState(uintptr_t identity, uintptr_t device_identity) : list(identity), device(device_identity) {
+    events.context = this;
+    events.legacy = [](void* opaque, UINT count, const D3D12_RESOURCE_BARRIER* barriers) noexcept {
+      auto* self = static_cast<ODVNativeState*>(opaque);
+      try {
+        const std::lock_guard lock(self->mutex); ++self->legacy_calls;
+        if (count > 4096 || self->protected_session) { self->states.invalidate_all(); self->failed = true; return; }
+        self->states.observe(count, barriers);
+      } catch (...) { self->failed = true; }
+    };
+    events.enhanced = [](void* opaque, UINT32 count, const D3D12_BARRIER_GROUP* groups) noexcept {
+      auto* self = static_cast<ODVNativeState*>(opaque);
+      try {
+        const std::lock_guard lock(self->mutex); ++self->enhanced_calls;
+        if (count > 4096 || (count && !groups) || self->protected_session) {
+          self->states.invalidate_all(); self->failed = true; return;
+        }
+        uint64_t total = 0;
+        for (UINT32 i = 0; i < count; ++i) {
+          total += groups[i].NumBarriers;
+          if (total > 4096 || (groups[i].NumBarriers && !groups[i].pBufferBarriers)) {
+            self->states.invalidate_all(); self->failed = true; return;
+          }
+        }
+        for (UINT32 i = 0; i < count; ++i) {
+          if (groups[i].Type == D3D12_BARRIER_TYPE_BUFFER) self->enhanced_buffers += groups[i].NumBarriers;
+          else if (groups[i].Type == D3D12_BARRIER_TYPE_TEXTURE) self->enhanced_textures += groups[i].NumBarriers;
+          else if (groups[i].Type == D3D12_BARRIER_TYPE_GLOBAL) self->enhanced_globals += groups[i].NumBarriers;
+        }
+        self->states.observe_enhanced(count, groups);
+      } catch (...) { self->failed = true; }
+    };
+    events.invalidate = [](void* opaque, odv::research::NativeStateInvalidation reason) noexcept {
+      auto* self = static_cast<ODVNativeState*>(opaque);
+      try {
+        const std::lock_guard lock(self->mutex);
+        if (reason == odv::research::NativeStateInvalidation::reset) {
+          self->states.reset(); self->protected_session = false; self->failed = false;
+        } else {
+          self->states.invalidate_all();
+          if (reason == odv::research::NativeStateInvalidation::protected_session) self->protected_session = true;
+        }
+      } catch (...) { self->failed = true; }
+    };
+    events.after_execute = [](void* opaque, ID3D12CommandQueue* queue) noexcept {
+      auto* self = static_cast<ODVNativeState*>(opaque);
+      try {
+        { const std::lock_guard lock(self->mutex); ++self->after_calls; }
+        odv_constant_driver.after_execute(self->list, queue);
+      } catch (...) { self->failed = true; }
+    };
+  }
