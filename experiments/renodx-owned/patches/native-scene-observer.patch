+void ODVInstallNativeState(reshade::api::command_list* cmd_list) {
+  if (!odv_default_constants || cmd_list->get_device()->get_api() != reshade::api::device_api::d3d12) return;
+  auto* data = renodx::utils::data::Get<CommandListData>(cmd_list);
+  if (data == nullptr) return;
+  auto state = std::make_shared<ODVNativeState>(reinterpret_cast<uintptr_t>(cmd_list), static_cast<uintptr_t>(cmd_list->get_device()->get_native()));
+  {
+    const std::lock_guard lock(odv_native_registry_mutex);
+    std::erase_if(odv_native_registry, [](const auto& value) { return value.expired(); });
+    if (odv_native_registry.size() >= 4096) return;
+    odv_native_registry.emplace_back(state);
+  }
+  data->odv_native_state = std::move(state);
+  cmd_list->set_private_data(odv::research::native_barrier_events_guid, reinterpret_cast<uint64_t>(&data->odv_native_state->events));
+}
+void ODVRemoveNativeState(reshade::api::command_list* cmd_list) {
+  cmd_list->set_private_data(odv::research::native_barrier_events_guid, 0);
+}
+void ODVForgetNativeResource(reshade::api::device* device, reshade::api::resource resource) {
+  const auto native_device = static_cast<uintptr_t>(device->get_native());
+  const std::lock_guard registry_lock(odv_native_registry_mutex);
+  std::erase_if(odv_native_registry, [&](const auto& value) {
+    auto state = value.lock(); if (!state) return true;
+    if (state->device == native_device) { const std::lock_guard lock(state->mutex); state->states.forget(reinterpret_cast<ID3D12Resource*>(resource.handle)); }
+    return false;
+  });
+}
