+    static const std::regex store(
+        R"(^call void @dx.op.storeOutput\.f32\(i32 5, i32 ([0-9]+), i32 ([0-9]+), i8 ([0-9]+), float ([A-Za-z0-9_%+.-]+)\)(?:,.*)?$)");
+    std::map<std::string, std::string> definitions;
+    std::array<std::string, 4> roots;
