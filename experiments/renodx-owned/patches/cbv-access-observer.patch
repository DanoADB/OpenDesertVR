+      catch (...) { self->failed = true; }
+    };
+    draw_events.query = [](void* opaque, ID3D12QueryHeap* heap, D3D12_QUERY_TYPE type, UINT index, bool begin) noexcept {
+      auto* self = static_cast<ODVNativeState*>(opaque);
+      try { const std::lock_guard lock(self->mutex); self->draw_state.query(heap,type,index,begin); }
+      catch (...) { self->failed = true; }
+    };
+    draw_events.render_pass = [](void* opaque, bool begin, D3D12_RENDER_PASS_FLAGS flags) noexcept {
+      auto* self = static_cast<ODVNativeState*>(opaque);
+      try { const std::lock_guard lock(self->mutex); self->draw_state.render_pass(begin,flags); }
