+      auto* self = static_cast<ODVNativeState*>(opaque);
+      try {
+        const std::lock_guard lock(self->mutex);
+        if (phase == odv::research::NativeIndirectPhase::before_record) {
+          if (self->indirect_active || call == nullptr) { self->failed = true; return; }
