+      auto* self = static_cast<ODVNativeState*>(opaque);
+      try { const std::lock_guard lock(self->mutex); self->indirect_capable = mask == 1; }
+      catch (...) { self->failed = true; }
+    };
+    indirect_events.record = [](void* opaque, const odv::research::NativeIndirectCall* call,
