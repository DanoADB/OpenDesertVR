# Test the actual loader failure path, independent of the installed runtime/HMD.
set(ENV{XR_RUNTIME_JSON} "${CMAKE_CURRENT_BINARY_DIR}/intentionally-absent-runtime.json")
execute_process(COMMAND "${CLI}" export-report --output "${CMAKE_CURRENT_BINARY_DIR}/missing-runtime.json" RESULT_VARIABLE result TIMEOUT 20)
if(NOT result EQUAL 3)
  message(FATAL_ERROR "Missing runtime must exit 3, got ${result}")
endif()
file(READ "${CMAKE_CURRENT_BINARY_DIR}/missing-runtime.json" report)
string(JSON ready GET "${report}" ready)
string(JSON version GET "${report}" schema_version)
string(JSON headset GET "${report}" headset_validation)
string(JSON count LENGTH "${report}" checks)
math(EXPR last "${count} - 1")
string(JSON category GET "${report}" checks ${last} name)
string(JSON status GET "${report}" checks ${last} status)
if(ready OR NOT version EQUAL 1 OR NOT headset STREQUAL "NOT_RUN" OR NOT category STREQUAL "runtime" OR NOT status STREQUAL "FAIL")
  message(FATAL_ERROR "Invalid missing-runtime diagnostic: ${report}")
endif()
if(report MATCHES "intentionally-absent|Users|adapterLuid|serial")
  message(FATAL_ERROR "Report contains private runtime information")
endif()
