cmake_minimum_required(VERSION 3.24)
set(directory "${CMAKE_CURRENT_BINARY_DIR}/collector-${SCENARIO}")
file(MAKE_DIRECTORY "${directory}")
file(REMOVE "${directory}/doctor.json" "${directory}/host.json" "${directory}/test-config.json" "${directory}/run-summary.json")
set(ENV{XR_RUNTIME_JSON} "${MANIFEST}")
set(ENV{ODV_MOCK_SCENARIO} "${SCENARIO}")
set(ENV{ODV_MOCK_AUDIT} "${directory}/audit.json")
execute_process(COMMAND powershell.exe -NoProfile -ExecutionPolicy Bypass -File "${RUNNER}"
  -PackageDirectory "${PACKAGE}" -OutputDirectory "${directory}" -DurationSeconds 1
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
set(expected 0)
if(SCENARIO STREQUAL "missing_headset")
  set(expected 3)
endif()
# Reusing an output folder must reject the run without modifying any evidence.
set(evidence_files doctor.json run-summary.json)
if(SCENARIO STREQUAL "normal")
  list(APPEND evidence_files host.json test-config.json)
endif()
foreach(name IN LISTS evidence_files)
  file(SHA256 "${directory}/${name}" before_${name})
endforeach()
execute_process(COMMAND powershell.exe -NoProfile -ExecutionPolicy Bypass -File "${RUNNER}"
  -PackageDirectory "${PACKAGE}" -OutputDirectory "${directory}" -DurationSeconds 1
  RESULT_VARIABLE reused_result OUTPUT_VARIABLE reused_output ERROR_VARIABLE reused_errors TIMEOUT 5)
if(NOT reused_result EQUAL 1)
  message(FATAL_ERROR "Collector accepted existing evidence: ${reused_result}")
endif()
foreach(name IN LISTS evidence_files)
  file(SHA256 "${directory}/${name}" after)
  if(NOT after STREQUAL before_${name})
    message(FATAL_ERROR "Collector overwrote existing ${name}")
  endif()
endforeach()
if(NOT result EQUAL expected)
  message(FATAL_ERROR "Collector exit ${result}, expected ${expected}\n${output}\n${errors}")
endif()
file(READ "${directory}/run-summary.json" summary)
string(JSON headset GET "${summary}" headset_validation)
string(JSON game GET "${summary}" game_validation)
string(JSON invoked GET "${summary}" host_invoked)
if(NOT headset STREQUAL "NOT_RUN" OR NOT game STREQUAL "NOT_RUN")
  message(FATAL_ERROR "Collector fabricated hardware evidence: ${summary}")
endif()
if(SCENARIO STREQUAL "missing_headset")
  if(invoked OR EXISTS "${directory}/host.json")
    message(FATAL_ERROR "Collector launched host despite missing requirements")
  endif()
else()
  string(JSON technical GET "${summary}" technical_submission)
  string(JSON test_runtime GET "${summary}" test_runtime)
  if(NOT invoked OR NOT test_runtime OR NOT technical STREQUAL "PASS")
    message(FATAL_ERROR "Collector did not preserve software evidence grade: ${summary}")
  endif()
endif()
