cmake_minimum_required(VERSION 3.24)
set(directory "${CMAKE_CURRENT_BINARY_DIR}/mock-depth-preview")
file(MAKE_DIRECTORY "${directory}")
set(ENV{XR_RUNTIME_JSON} "${MANIFEST}")
file(WRITE "${directory}/config.json" "{\"schema_version\":1,\"duration_seconds\":1}")
foreach(scenario normal invalid_tracking session_loss missing_headset)
  set(ENV{ODV_MOCK_SCENARIO} "${scenario}")
  set(ENV{ODV_MOCK_AUDIT} "${directory}/${scenario}-audit.json")
  execute_process(COMMAND "${HOST}" --depth-preview --config "${directory}/config.json"
    --report "${directory}/${scenario}-report.json" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
  if(scenario STREQUAL "normal" OR scenario STREQUAL "invalid_tracking")
    set(expected 0)
  else()
    set(expected 3)
  endif()
  if(NOT result EQUAL expected)
    message(FATAL_ERROR "Depth preview ${scenario}: ${result}, expected ${expected}\n${output}\n${errors}")
  endif()
  file(READ "${directory}/${scenario}-report.json" report)
  foreach(field headset_validation game_validation game_camera_tracking)
    string(JSON value GET "${report}" ${field})
    if(NOT value STREQUAL "NOT_RUN")
      message(FATAL_ERROR "Preview awarded game/headset validation: ${report}")
    endif()
  endforeach()
  if(NOT scenario STREQUAL "missing_headset")
    string(JSON technique GET "${report}" stereo_technique)
    string(JSON origin GET "${report}" stream_origin)
    string(JSON pairs GET "${report}" source_pairs_received)
    string(JSON owned GET "${report}" owned_depth_preview)
    if(NOT technique STREQUAL "DEPTH_RECONSTRUCTED" OR NOT origin STREQUAL "OWNED_GEOMETRY" OR NOT owned OR pairs LESS 1 OR report MATCHES "EYE_GEOMETRY")
      message(FATAL_ERROR "Preview lost stream/reconstruction provenance: ${report}")
    endif()
    if(scenario STREQUAL "normal" AND pairs LESS 2)
      message(FATAL_ERROR "Preview displayed a frozen lease instead of advancing the image stream: ${report}")
    endif()
    file(READ "${directory}/${scenario}-audit.json" audit)
    foreach(field violations swapchains_remaining)
      string(JSON value GET "${audit}" ${field})
      if(NOT value EQUAL 0)
        message(FATAL_ERROR "Invalid preview runtime teardown: ${audit}")
      endif()
    endforeach()
    string(JSON acquired GET "${audit}" acquisitions)
    string(JSON released GET "${audit}" releases)
    string(JSON destroyed GET "${audit}" session_destroyed)
    if(NOT acquired EQUAL released OR NOT destroyed)
      message(FATAL_ERROR "Unbalanced preview eye ownership: ${audit}")
    endif()
  endif()
endforeach()
message(STATUS "PASS: owned reconstructed stereo through GPU transport and XR; tracking gaps, session loss, missing headset; game/headset NOT_RUN")
