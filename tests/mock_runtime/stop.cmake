cmake_minimum_required(VERSION 3.24)
set(directory "${CMAKE_CURRENT_BINARY_DIR}/mock-cooperative-stop")
file(MAKE_DIRECTORY "${directory}")
file(REMOVE "${directory}/audit.json" "${directory}/report.json")
set(ENV{XR_RUNTIME_JSON} "${MANIFEST}")
set(ENV{ODV_MOCK_SCENARIO} "request_exit")
set(ENV{ODV_MOCK_AUDIT} "${directory}/audit.json")
execute_process(COMMAND "${HOST}" "${directory}/report.json" RESULT_VARIABLE result TIMEOUT 15)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cooperative stop failed: ${result}")
endif()
file(READ "${directory}/audit.json" audit)
foreach(field violations swapchains_remaining)
  string(JSON value GET "${audit}" ${field})
  if(NOT value EQUAL 0)
    message(FATAL_ERROR "Stop left invalid runtime state: ${audit}")
  endif()
endforeach()
foreach(field session_destroyed space_destroyed request_exit_called)
  string(JSON value GET "${audit}" ${field})
  if(NOT value)
    message(FATAL_ERROR "Stop did not request/finish orderly shutdown: ${audit}")
  endif()
endforeach()
file(READ "${directory}/report.json" report)
foreach(field headset_validation game_validation)
  string(JSON value GET "${report}" ${field})
  if(NOT value STREQUAL "NOT_RUN")
    message(FATAL_ERROR "Software test awarded hardware validation")
  endif()
endforeach()
