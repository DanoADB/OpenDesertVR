cmake_minimum_required(VERSION 3.24)
set(directory "${CMAKE_CURRENT_BINARY_DIR}/mock-${SCENARIO}")
file(MAKE_DIRECTORY "${directory}")
set(report "${directory}/report.json")
set(audit "${directory}/audit.json")
file(REMOVE "${report}" "${audit}")
file(WRITE "${directory}/config.json" "{\"schema_version\":1,\"duration_seconds\":1}")
set(ENV{XR_RUNTIME_JSON} "${MANIFEST}")
set(ENV{ODV_MOCK_SCENARIO} "${SCENARIO}")
set(ENV{ODV_MOCK_AUDIT} "${audit}")
execute_process(COMMAND "${HOST}" --config "${directory}/config.json" --report "${report}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
set(success normal request_exit skip_render invalid_tracking wait_timeout)
if(SCENARIO IN_LIST success)
  set(expected 0)
else()
  set(expected 3)
endif()
if(NOT result EQUAL expected)
  message(FATAL_ERROR "${SCENARIO}: exit ${result}, expected ${expected}\n${output}\n${errors}")
endif()
file(READ "${report}" json)
string(JSON headset GET "${json}" headset_validation)
string(JSON game GET "${json}" game_validation)
if(NOT headset STREQUAL "NOT_RUN" OR NOT game STREQUAL "NOT_RUN")
  message(FATAL_ERROR "Mock runtime must never award headset/game validation")
endif()
string(JSON checks LENGTH "${json}" checks)
math(EXPR last "${checks}-1")
if(NOT SCENARIO STREQUAL "missing_extension")
  string(JSON test_runtime GET "${json}" test_runtime)
  if(NOT test_runtime)
    message(FATAL_ERROR "Host did not identify test-only runtime")
  endif()
  file(READ "${audit}" audit_json)
  foreach(field violations swapchains_remaining)
    string(JSON value GET "${audit_json}" ${field})
    if(NOT value EQUAL 0)
      message(FATAL_ERROR "Runtime audit ${field}=${value}\n${audit_json}\n${json}")
    endif()
  endforeach()
  foreach(field session_destroyed space_destroyed)
    string(JSON value GET "${audit_json}" ${field})
    if(NOT value)
      message(FATAL_ERROR "Runtime resources leaked: ${audit_json}")
    endif()
  endforeach()
endif()
if(SCENARIO IN_LIST success)
  string(JSON submitted GET "${json}" stereo_frames)
  string(JSON runtime_submitted GET "${audit_json}" stereo_submissions)
  if(submitted LESS 1 OR NOT submitted EQUAL runtime_submitted)
    message(FATAL_ERROR "Stereo layer submission not verified: ${json}\n${audit_json}")
  endif()
  string(JSON gpu GET "${json}" gpu_timing)
  if(NOT gpu STREQUAL "PASS")
    message(FATAL_ERROR "No real D3D12 GPU timing: ${json}")
  endif()
  string(JSON acquired GET "${audit_json}" acquisitions)
  string(JSON released GET "${audit_json}" releases)
  math(EXPR expected_images "${submitted}*2")
  if(NOT acquired EQUAL expected_images OR NOT released EQUAL expected_images)
    message(FATAL_ERROR "Swapchain image ownership imbalance: ${audit_json}")
  endif()
  if(SCENARIO STREQUAL "request_exit")
    string(JSON request_exit GET "${audit_json}" request_exit_called)
    if(NOT request_exit)
      message(FATAL_ERROR "Host duration did not request orderly exit")
    endif()
  endif()
elseif(NOT SCENARIO STREQUAL "all_skip")
  string(JSON status GET "${json}" checks ${last} status)
  string(JSON category GET "${json}" checks ${last} name)
  set(expected_category session)
  if(SCENARIO STREQUAL "missing_headset")
    set(expected_category headset)
  elseif(SCENARIO STREQUAL "missing_extension")
    set(expected_category extension)
  elseif(SCENARIO STREQUAL "wrong_adapter")
    set(expected_category adapter)
  elseif(SCENARIO STREQUAL "allocation_failure" OR SCENARIO STREQUAL "second_allocation_failure")
    set(expected_category allocation)
  endif()
  if(NOT status STREQUAL "FAIL" OR NOT category STREQUAL expected_category)
    message(FATAL_ERROR "Wrong failure category: ${json}")
  endif()
endif()
message(STATUS "${SCENARIO}: exit, evidence grade, GPU/frame protocol and cleanup checks passed")
